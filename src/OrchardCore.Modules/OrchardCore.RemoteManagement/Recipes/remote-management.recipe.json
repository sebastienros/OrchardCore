{
  "name": "RemoteManagement",
  "displayName": "Orchard Core Remote Management",
  "description": "Configures the OpenID Connect server, token validation, management scope, and public native client required by the Orchard Core CLI.",
  "author": "The Orchard Core Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": false,
  "categories": [ "api", "security" ],
  "tags": [ "cli", "openid", "openapi", "remote-management" ],
  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.RemoteManagement",
        "OrchardCore.OpenId.Management",
        "OrchardCore.OpenId.Server",
        "OrchardCore.OpenId.Validation"
      ]
    },
    {
      "name": "RemoteManagementConfiguration"
    },
    {
      "name": "ReloadTenant"
    }
  ]
}
