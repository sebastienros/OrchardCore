<section class="saas-hero">
    <div class="saas-hero__copy">
        <span class="saas-eyebrow">@T["Orchard Core SaaS"]</span>
        <h1>@T["Your sites, connected and ready."]</h1>
        <p class="saas-hero__lead">@T["Create and operate secure tenants from a flexible platform designed to grow with your organization."]</p>
        <div class="saas-hero__actions">
            <a class="btn btn-primary btn-lg" href="@Url.Content("~/Admin")">@T["Open administration"]</a>
            <a class="btn btn-outline-secondary btn-lg" href="https://docs.orchardcore.net/" rel="noopener">@T["Read the documentation"]</a>
        </div>
        <p class="saas-hero__status">
            <span aria-hidden="true"></span>
            @T["Your SaaS tenant is configured and ready."]
        </p>
    </div>
    <div class="saas-hero__visual" aria-hidden="true">
        <div class="saas-orbit saas-orbit--one"></div>
        <div class="saas-orbit saas-orbit--two"></div>
        <div class="saas-console">
            <div class="saas-console__header">
                <span></span><span></span><span></span>
            </div>
            <div class="saas-console__body">
                <span class="saas-console__label">@T["Tenant network"]</span>
                <div class="saas-console__metric">
                    <strong>@T["Connected"]</strong>
                    <span>@T["Ready for secure management"]</span>
                </div>
                <div class="saas-console__nodes">
                    <span></span><span></span><span></span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="saas-features" aria-labelledby="saas-capabilities-title">
    <div class="saas-section-heading">
        <span class="saas-eyebrow">@T["Built to operate"]</span>
        <h2 id="saas-capabilities-title">@T["A dependable foundation for every tenant."]</h2>
    </div>
    <div class="saas-feature-grid">
        <article class="saas-feature">
            <span class="saas-feature__number">01</span>
            <h3>@T["Multi-tenant by design"]</h3>
            <p>@T["Keep sites independently configured while managing them from one trusted platform."]</p>
        </article>
        <article class="saas-feature">
            <span class="saas-feature__number">02</span>
            <h3>@T["Secure remote access"]</h3>
            <p>@T["Use standards-based authentication for reliable command-line and automation workflows."]</p>
        </article>
        <article class="saas-feature">
            <span class="saas-feature__number">03</span>
            <h3>@T["Ready to extend"]</h3>
            <p>@T["Add features as your service evolves without compromising the tenant experience."]</p>
        </article>
    </div>
</section>
